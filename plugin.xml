<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        id="cordova-plugin-ios-locale"
        version="2.0.2">
    <name>IOSLocale</name>
    <description>Sets CFBundleDevelopmentRegion and CFBundleLocalizations in the iOS Info.plist, configurable via a preference.</description>
    <license>Apache 2.0</license>

    <preference name="IOSLOCALE_DEV_REGION" default="en" />

    <platform name="ios">
        <config-file target="*-Info.plist" parent="CFBundleDevelopmentRegion" overwrite="true">
            <string>$IOSLOCALE_DEV_REGION</string>
        </config-file>

        <config-file target="*-Info.plist" parent="CFBundleLocalizations" overwrite="true">
            <array>
                <string>$IOSLOCALE_DEV_REGION</string>
            </array>
        </config-file>
    </platform>
</plugin>
